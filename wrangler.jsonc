{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "coast-easy",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "FLEET_FEED", "class_name": "FleetFeed" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FleetFeed"] }]
}
